# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already in .gitignore.

# MongoDB Atlas connection string (Database > Connect > Drivers > Node.js)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/airtrace-ai?appName=Cluster0

# Secret used to sign login tokens — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of allowed frontend origins (production)
# FRONTEND_URL=https://air-trace-ai.vercel.app

# Port the backend listens on (Render sets this automatically)
PORT=5000
