# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already in .gitignore.

# MongoDB Atlas connection string (Database > Connect > Drivers > Node.js)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/airtrace-ai?appName=Cluster0

# Secret used to sign login tokens — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of allowed frontend origins (production)
# FRONTEND_URL=https://air-trace-ai.vercel.app

# Groq API key (get free from https://console.groq.com/keys) - tried first
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=openai/gpt-oss-20b   (optional - leave unset to auto-detect)

# Google Gemini API key (get free from https://aistudio.google.com)
# If not set, the chatbot automatically falls back to rule-based replies.
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-3.8-flash

# Port the backend listens on (Render sets this automatically)
PORT=5000
